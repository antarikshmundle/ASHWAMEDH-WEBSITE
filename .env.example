# Copy this file to .env.local (or .env) and fill in values. Never commit either file.
# Each variable once: a later line with the same name — even an empty one — overrides the earlier one.
# Restart the dev server after changing values.

# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs, Open Graph, sitemap and robots.
# Hosting/domain is not finalized yet — leave unset locally to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Admin sign-in (Phase 10.1, docs/architecture/admin-cms.md). Server-only; leave unset to disable /admin.
# ADMIN_USERNAME: 1–64 characters.
# ADMIN_PASSWORD_HASH: output of `npm run admin:hash` (scrypt:…, never the password itself; paste unquoted).
# ADMIN_SESSION_SECRET: at least 32 random characters, e.g. `openssl rand -base64 48`.
#   Without OpenSSL: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# CMS content (Phase 10.2, docs/architecture/admin-cms.md). Server-only — never prefix with NEXT_PUBLIC_.
# CMS_CONTENT_SOURCE: "repository" (default, no credentials needed) or "database" (Supabase PostgreSQL).
# SUPABASE_URL: https://<project-ref>.supabase.co (http://127.0.0.1:54321 for a local Supabase).
# SUPABASE_SERVICE_ROLE_KEY: the project's service-role / secret key. Keep it secret; never commit it.
CMS_CONTENT_SOURCE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
